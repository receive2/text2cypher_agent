# API keys only. Model choice lives in eval_config.py (GENERATOR_LLM), never here.
# OPENAI_API_KEY is needed by EVERYONE, whatever GENERATOR_LLM you run: setup builds the schema
# metadata with gpt-4.1, and tool routing / FCAV embed with OpenAI text-embedding-3-small.
OPENAI_API_KEY=your-openai-api-key-here            # platform.openai.com -> API keys   (gpt-4.1, gpt-5.6-terra, gpt-5.6-luna)
ANTHROPIC_API_KEY=your-anthropic-api-key-here      # console.anthropic.com -> API Keys (claude-sonnet-5, claude-haiku-4.5; claude-opus-5 optional)
DEEPINFRA_API_KEY=your-deepinfra-api-key-here      # deepinfra.com -> Dashboard -> API Keys (deepseek-v3.1, llama-3.3-70b)
TOGETHER_API_KEY=your-together-api-key-here        # optional alternate host for the two open-weights models
OPENAI_ORG_ID=your-openai-org-id-here              # optional
HUGGINGFACE_TOKEN=your-huggingface-token-here      # only for the HF-router / fine-tuned entries in MODEL_REGISTRY
GROQ_API_KEY=your-groq-key-here                    # only for the Groq entries in MODEL_REGISTRY
# Neo4j for the *agent demo / setup scripts* (the evaluation harness reads its
# graph connections from eval_config.py, which is committed for reviewers).
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j
