# ──────────────────────────────────────────────────────────────────────────────
# Ignore everything by default, then whitelist specific file types
# ──────────────────────────────────────────────────────────────────────────────

# Ignore everything
*

# But not .gitignore itself
!.gitignore

# Whitelist .py, .md, and requirements.txt
!*.py
!*.md
!requirements.txt
!.env.example

# Allow descent into subdirectories so the whitelists above apply recursively
# (without this, `*` blocks git from visiting subdirs at all)
!*/

# ──────────────────────────────────────────────────────────────────────────────
# Directories to always ignore (even if they contain .py/.md files)
# ──────────────────────────────────────────────────────────────────────────────

__pycache__/
faiss_tools/
faiss_tools_auto/
llmenv/
t2c/
not_use_code/

# ──────────────────────────────────────────────────────────────────────────────
# Other common ignores
# ──────────────────────────────────────────────────────────────────────────────

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# ──────────────────────────────────────────────────────────────────────────────
# Refactor additions (2026-04-28)
# ──────────────────────────────────────────────────────────────────────────────

# Python cache
*.pyc
.ipynb_checkpoints/

# Runtime data
schema_data/
logs/

# Generated artifacts (keep .py files tracked, ignore everything else)
generated/tool_descriptions.csv
generated/faiss/

# Backups
*.bak
