# ──────────────────────────────────────────────────────────────────────────────
# Ignore everything by default, then whitelist specific file types
# ──────────────────────────────────────────────────────────────────────────────

# Ignore everything
*

# But not .gitignore itself
!.gitignore

# Whitelist .py, .md, .sh, requirements.txt, and Jupyter notebooks
!*.py
!*.md
!*.sh
!*.ipynb
!requirements.txt
!.env.example

# Allow descent into subdirectories so the whitelists above apply recursively
# (without this, `*` blocks git from visiting subdirs at all)
!*/

# ──────────────────────────────────────────────────────────────────────────────
# Directories to always ignore (even if they contain .py/.md files)
# ──────────────────────────────────────────────────────────────────────────────

__pycache__/
faiss_tools/
faiss_tools_auto/
llmenv/
t2c/
not_use_code/

# ──────────────────────────────────────────────────────────────────────────────
# Other common ignores
# ──────────────────────────────────────────────────────────────────────────────

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# ──────────────────────────────────────────────────────────────────────────────
# Refactor additions (2026-04-28)
# ──────────────────────────────────────────────────────────────────────────────

# Python cache
*.pyc
.ipynb_checkpoints/

# Runtime data
schema_data/
logs/

# Data-augmentation LLM cache (cache/augmenter_paraphrase.jsonl).
# Note: the broad `*` rule near the top already ignores non-whitelisted
# files, but we keep this explicit for clarity and to discourage
# accidentally tracking a large response cache.
cache/

# Generated artifacts (keep .py files tracked, ignore everything else)
generated/tool_descriptions.csv
generated/faiss/

# Backups
*.bak

# ──────────────────────────────────────────────────────────────────────────────
# Per-graph eval harness (2026-04-30)
# ──────────────────────────────────────────────────────────────────────────────

# eval_config.py holds Neo4j credentials in GRAPH_CONNS — must NOT be
# committed.  This explicit entry overrides the !*.py whitelist above.
# NOTE: if eval_config.py is currently tracked by git, you must run
#   git rm --cached eval_config.py
# to untrack the live copy without deleting it from disk.
eval_config.py

# Live "which (dataset, graph) is currently swapped in" sentinel,
# written by eval/artifact_swap.py.
.current_setup

# Per-graph archived setup outputs — large, machine-generated, and
# tied to private database contents; recreate via scripts/setup_and_archive.py.
setup_artifacts/
# Quarantined / stale artifact snapshots (never ship these).
setup_artifacts.*
# Conversation/session exports and stray run logs — never commit.
exported_conversation*
*.log
cypherbench/
datasets/
# Tracked source package — exempt from the broad datasets/ ignore above.
!data_augmentation/datasets/
!data_augmentation/datasets/**
verification/

# ──────────────────────────────────────────────────────────────────────────────
# Released perturbed benchmarks (shared with auditors / for reproducibility)
# ──────────────────────────────────────────────────────────────────────────────
!benchmarks/
!benchmarks/**

.early.coverage